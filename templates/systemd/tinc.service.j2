[Unit]
Description=tinc ({{ tinc_identifier }})
{% for service in tinc_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in tinc_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ tinc_container_cleanup_command | trim | replace("\n", " ") }}'

{#
  tincd runs as root inside the container, because it needs NET_ADMIN to create the VPN interface
  (through /dev/net/tun), and for the `ip` commands of tinc-up and tinc-down. The configuration files
  are still owned by tinc_uid:tinc_gid on the host, which is what DAC_READ_SEARCH lets it read.
  NET_BIND_SERVICE lets it bind port 655 with host networking, where Docker does not lift the
  privileged port limit as it does for container networks.
#}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ tinc_identifier }} \
      --log-driver=none \
      --cap-drop=ALL \
      --cap-add=DAC_READ_SEARCH \
      --cap-add=NET_ADMIN \
      --cap-add=NET_BIND_SERVICE \
      --device=/dev/net/tun \
      --read-only \
      --network={{ tinc_container_network }} \
      {% if tinc_container_host_bind_port_tcp %}
      -p {{ tinc_container_host_bind_port_tcp }}:655/tcp \
      {% endif %}
      {% if tinc_container_host_bind_port_udp %}
      -p {{ tinc_container_host_bind_port_udp }}:655/udp \
      {% endif %}
      --env-file={{ tinc_base_path }}/env \
      --mount type=bind,src={{ tinc_config_path }},dst=/etc/tinc,ro \
      {% for volume in tinc_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      --tmpfs=/run:rw,noexec,nosuid,size={{ tinc_container_tmpfs_run_size }} \
      {% for arg in tinc_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ tinc_container_image_self_build_name if tinc_container_image_self_build else tinc_container_image }} \
      --config=/etc/tinc \
      --no-detach \
      {% for arg in tinc_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

{% if tinc_container_network != 'host' %}
{% for network in tinc_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ tinc_identifier }}
{% endfor %}
{% endif %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ tinc_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ tinc_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ tinc_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ tinc_identifier }}

[Install]
WantedBy=multi-user.target
